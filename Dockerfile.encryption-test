FROM golang:1.26.10-alpine AS builder

RUN apk add --no-cache git ca-certificates

WORKDIR /app

COPY go.mod go.sum ./
RUN go mod download

COPY . .

RUN CGO_ENABLED=0 GOOS=linux go build -tags vector -a -installsuffix cgo \
    -ldflags '-extldflags "-static"' \
    -o warp-storage-engine ./cmd/warp-storage-engine

FROM alpine:latest

RUN apk --no-cache add wget ca-certificates curl

COPY --from=builder /app/warp-storage-engine /warp-storage-engine
COPY web /web
COPY api /api

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost:8080/health || exit 1

ENTRYPOINT ["/warp-storage-engine"]
